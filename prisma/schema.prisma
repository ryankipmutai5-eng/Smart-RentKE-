generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Landlord {
  id                    String   @id @default(cuid())
  name                  String
  email                 String   @unique
  phone                 String?
  payhero_api_key       String?
  payhero_merchant_id   String?
  whatsapp_api_token    String?
  whatsapp_instance_id  String?
  tenants               Tenant[]
  payments              Payment[]
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

model Tenant {
  id            String    @id @default(cuid())
  landlord_id   String
  landlord      Landlord  @relation(fields: [landlord_id], references: [id])
  name          String
  phone         String
  house_number  String
  rent_amount   Float
  due_date      Int       @default(1) // Day of the month
  is_active     Boolean   @default(true)
  payments      Payment[]
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model Payment {
  id                 String    @id @default(cuid())
  tenant_id          String
  tenant             Tenant    @relation(fields: [tenant_id], references: [id])
  landlord_id        String
  landlord           Landlord  @relation(fields: [landlord_id], references: [id])
  amount             Float
  service_fee        Float     @default(20.0)
  status             String    @default("pending") // pending, successful, failed
  payhero_reference  String?
  external_reference String?
  paid_at            DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
}
